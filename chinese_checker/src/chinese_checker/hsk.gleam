pub fn known_words_for_levels(
  old_level: Option(Int),
  new_level: Option(Int),
) -> Set(String) {
  let old = case old_level {
    None -> set.new()
    Some(1) -> hsk1()
    Some(2) -> set.union(hsk1(), hsk2())
    Some(3) -> set.union(set.union(hsk1(), hsk2()), hsk3())
    Some(4) -> set.union(set.union(set.union(hsk1(), hsk2()), hsk3()), hsk4())
    Some(5) -> set.union(set.union(set.union(set.union(hsk1(), hsk2()), hsk3()), hsk4()), hsk5())
    Some(_) -> set.new()
  }
  let new = case new_level {
    None -> set.new()
    Some(1) -> hsk_band1()
    Some(2) -> set.union(hsk_band1(), hsk_band2())
    Some(3) -> set.union(set.union(hsk_band1(), hsk_band2()), hsk_band3())
    Some(_) -> set.new()
  }
  set.union(old, new)
}
